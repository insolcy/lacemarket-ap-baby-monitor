{
  "name": "lacemarket-github-scheduler",
  "main": "worker.js",
  "compatibility_date": "2026-08-27",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "secrets": {
    "required": ["GITHUB_TOKEN"]
  },
  "triggers": {
    "crons": ["*/10 * * * *"]
  }
}
